# Copy this file to .env and fill in your AuraDB instance's connection details
# (Aura console -> your instance -> Connect). Restore data/db.backup into that
# instance first if you're starting fresh.

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# This project (docintel_aga = "Aura Graph Analytics") runs GDS as a
# separate, on-demand Session rather than as procedures embedded in the
# AuraDB instance, so it needs its own Aura API credentials in addition to
# the plain DB login above. Create a key pair in the Aura Console under
# your account/organization's "API Keys" settings (this is account-level
# access, not your DB password -- treat it accordingly).
AURA_API_CLIENT_ID=
AURA_API_CLIENT_SECRET=
# Only needed if your Aura account has more than one project.
AURA_API_PROJECT_ID=
